# ============================================================
#  Server environment configuration
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit the real .env file to version control.
#
#  NOTE: this file is read ONLY when NODE_ENV is not "production".
#  On a hosting platform, set these variables in its dashboard instead —
#  a deployed .env would override the platform's values.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ---
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Database Access -> add a user with a password
# 3. Network Access  -> allow your current IP (or 0.0.0.0/0 for dev only)
# 4. Connect -> Drivers -> copy the connection string and paste it below.
#    Replace <username>, <password> and <cluster-url> with your own.
#    IMPORTANT: if your password contains @ : / or #, URL-encode it.
#
# Example shape:
# MONGODB_URI=mongodb+srv://myuser:MyPass123@cluster0.abcde.mongodb.net/socialapp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/socialapp?retryWrites=true&w=majority

# --- JWT ---
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# In production this MUST be at least 32 characters and must not be a
# placeholder — the server refuses to boot otherwise, because a weak secret
# lets anyone forge a valid token for any user.
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
#
# In development both loopback spellings are listed so the app works whether
# you open it as http://localhost:5173 or http://127.0.0.1:5173 - they are
# different Origins as far as the browser is concerned.
#
# In production this MUST be your real public URL and has no default:
#   CLIENT_ORIGIN=https://mern-memories.onrender.com
# Leaving it unset in production stops the server from starting, because an
# empty allowlist rejects every request the browser makes.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
# Where processed images are written. Relative paths resolve from server/.
# Defaults to server/uploads when unset.
# UPLOAD_DIR=./uploads

# Maximum size of a single uploaded file, in bytes. Default 5242880 (5 MB).
# MAX_UPLOAD_BYTES=5242880
